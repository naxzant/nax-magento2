        <referenceContainer name="before.body.end" remove="true"/>

        <referenceContainer name="root">

        <block
        class="Magento\Framework\View\Element\Template"
        name="love.proposal"
        template="Vendor_LoveProposal::love.phtml"
        />

        </referenceContainer>

    </body>

</page>
