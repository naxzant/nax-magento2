<script>
const typingText = <?= /* @noEscape */ json_encode($typingPrompt) ?>;
const typingNode = document.getElementById("typing");
const yesButton = document.getElementById("yes");
const noButton = document.getElementById("no");
const message = document.getElementById("msg");
const music = document.getElementById("music");
const page = document.getElementById("proposal-page");

let typingIndex = 0;
let accepted = false;
let musicStarted = false;
let interactionUnlockBound = false;

function typeText() {
    if (typingIndex < typingText.length) {
        typingNode.textContent += typingText.charAt(typingIndex);
        typingIndex += 1;
        window.setTimeout(typeText, 55);
    }
}

function randomBetween(min, max) {
    return Math.random() * (max - min) + min;
}

function moveNoButton() {
    if (accepted) {
        return;
    }

    const rect = noButton.getBoundingClientRect();
    const margin = 12;
    const maxX = Math.max(window.innerWidth - rect.width - margin, margin);
    const maxY = Math.max(window.innerHeight - rect.height - margin, margin);
    const nextX = randomBetween(margin, maxX);
    const nextY = randomBetween(margin, maxY);

    noButton.style.left = nextX + "px";
    noButton.style.top = nextY + "px";
    noButton.style.transform = "none";
}

function keepNoButtonInViewport() {
    if (accepted) {
        return;
    }

    const rect = noButton.getBoundingClientRect();
    const margin = 12;
    const safeLeft = Math.min(Math.max(rect.left, margin), window.innerWidth - rect.width - margin);
    const safeTop = Math.min(Math.max(rect.top, margin), window.innerHeight - rect.height - margin);

    noButton.style.left = safeLeft + "px";
    noButton.style.top = safeTop + "px";
    noButton.style.transform = "none";
}

function moveIfNearTouch(event) {
    if (accepted || !event.touches || !event.touches[0]) {
        return;
    }

    const touch = event.touches[0];
    const rect = noButton.getBoundingClientRect();
    const buffer = 90;
    const inDangerZone =
        touch.clientX >= rect.left - buffer &&
        touch.clientX <= rect.right + buffer &&
        touch.clientY >= rect.top - buffer &&
        touch.clientY <= rect.bottom + buffer;

    if (inDangerZone || event.target === noButton) {
        moveNoButton();
    }
}

function spawnHearts(count) {
    for (let index = 0; index < count; index += 1) {
        const heart = document.createElement("div");
        heart.className = "heart";
        heart.textContent = Math.random() > 0.35 ? "💖" : "💕";
        heart.style.left = Math.random() * 100 + "%";
        heart.style.animationDuration = randomBetween(3, 6.5) + "s";
        heart.style.transform = "translateX(" + randomBetween(-30, 30) + "px)";
        page.appendChild(heart);

        window.setTimeout(function () {
            heart.remove();
        }, 7000);
    }
}

function tryPlayMusic() {
    if (musicStarted) {
        return;
    }

    music.volume = 0.7;
    music.muted = false;
    const playPromise = music.play();

    if (playPromise && typeof playPromise.then === "function") {
        playPromise
            .then(function () {
                musicStarted = true;
            })
            .catch(function () {});
    }
}

function unlockMusic() {
    music.muted = false;
    tryPlayMusic();
    document.removeEventListener("click", unlockMusic);
    document.removeEventListener("touchstart", unlockMusic);
    document.removeEventListener("pointerdown", unlockMusic);
    interactionUnlockBound = false;
}

function bindInteractionUnlock() {
    if (interactionUnlockBound) {
        return;
    }

    document.addEventListener("click", unlockMusic, { once: true });
    document.addEventListener("touchstart", unlockMusic, { once: true });
    document.addEventListener("pointerdown", unlockMusic, { once: true });
    interactionUnlockBound = true;
}

function bootstrapMusicOnLoad() {
    music.volume = 0.7;
    music.muted = false;
    const autoplayPromise = music.play();

    if (!autoplayPromise || typeof autoplayPromise.then !== "function") {
        return;
    }

    autoplayPromise
        .then(function () {
            musicStarted = true;
        })
        .catch(function () {
            music.muted = true;
            const mutedPromise = music.play();

            if (mutedPromise && typeof mutedPromise.then === "function") {
                mutedPromise
                    .then(function () {
                        bindInteractionUnlock();
                    })
                    .catch(function () {
                        bindInteractionUnlock();
                    });
            } else {
                bindInteractionUnlock();
            }
        });
}

yesButton.addEventListener("click", function () {
    accepted = true;
    message.style.display = "block";
    tryPlayMusic();
    spawnHearts(50);
});

noButton.addEventListener("mouseenter", moveNoButton);
noButton.addEventListener("pointerdown", function (event) {
    event.preventDefault();
    moveNoButton();
});
noButton.addEventListener("touchstart", function (event) {
    event.preventDefault();
    moveNoButton();
}, { passive: false });
document.addEventListener("touchstart", moveIfNearTouch, { passive: true });
window.addEventListener("resize", moveNoButton);
window.addEventListener("resize", keepNoButtonInViewport);
music.addEventListener("playing", function () {
    musicStarted = true;
});

typeText();
keepNoButtonInViewport();
bootstrapMusicOnLoad();
bindInteractionUnlock();

if (page.requestFullscreen && window.innerWidth < 769) {
    document.addEventListener("click", function enterFullscreenOnce() {
        page.requestFullscreen().catch(function () {});
        document.removeEventListener("click", enterFullscreenOnce);
    }, { once: true });
}
</script>
